# Publisher-copyright reports and failed download responses stay local.
/data/raw/apt29/vendor-reports/

# Government PDFs are catalogued in the manifest but are not redistributed here.
/data/raw/apt29/government/

# Never add collected executable or script payloads as malware samples.
/data/raw/**/malware-binaries/

# Generated test bytecode.
__pycache__/
*.pyc

# Repository-local synthetic peer trees and generated policy test output.
/.policy-test-tmp/
