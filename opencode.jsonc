{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "manager",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "deny" },
    { "action": "shell", "resource": "git log -1 --oneline", "effect": "allow" },
    { "action": "shell", "resource": "git branch --show-current*", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse HEAD", "effect": "allow" },
    { "action": "shell", "resource": "shasum -a 256 -c policy/shared-files.sha256", "effect": "allow" },
    { "action": "shell", "resource": "git difftool*", "effect": "deny" },
    { "action": "shell", "resource": "git diff *--no-index*", "effect": "deny" },
    { "action": "shell", "resource": "git *--help*", "effect": "deny" },
    { "action": "shell", "resource": "git help*", "effect": "deny" },
    { "action": "shell", "resource": "git *--show-signature*", "effect": "deny" },
    { "action": "shell", "resource": "git *--output*", "effect": "deny" },
    { "action": "shell", "resource": "git *--ext-diff*", "effect": "deny" },
    { "action": "shell", "resource": "git *--textconv*", "effect": "deny" },
    { "action": "shell", "resource": "git *-c *", "effect": "deny" },
    { "action": "shell", "resource": "git *--config-env*", "effect": "deny" },
    { "action": "shell", "resource": "git *--exec-path*", "effect": "deny" },
    { "action": "shell", "resource": "git *--paginate*", "effect": "deny" },
    { "action": "shell", "resource": "git *--no-pager*", "effect": "deny" },
    { "action": "shell", "resource": "git *core.pager*", "effect": "deny" },
    { "action": "shell", "resource": "git *pager.*", "effect": "deny" },
    { "action": "shell", "resource": "git *diff.external*", "effect": "deny" },
    { "action": "shell", "resource": "*;*", "effect": "deny" },
    { "action": "shell", "resource": "*&&*", "effect": "deny" },
    { "action": "shell", "resource": "*||*", "effect": "deny" },
    { "action": "shell", "resource": "*|*", "effect": "deny" },
    { "action": "shell", "resource": "*>*", "effect": "deny" },
    { "action": "shell", "resource": "*<*", "effect": "deny" },
    { "action": "shell", "resource": "*$(*", "effect": "deny" },
    { "action": "shell", "resource": "*${*", "effect": "deny" },
    { "action": "shell", "resource": "*`*", "effect": "deny" },
    { "action": "shell", "resource": "*\n*", "effect": "deny" },
    { "action": "shell", "resource": "*\\n*", "effect": "deny" },
    { "action": "shell", "resource": "git commit*", "effect": "deny" },
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "git merge*", "effect": "deny" },
    { "action": "shell", "resource": "terraform apply*", "effect": "deny" },
    { "action": "shell", "resource": "terraform destroy*", "effect": "deny" },
    { "action": "shell", "resource": "az *", "effect": "deny" },
    { "action": "shell", "resource": "rm *", "effect": "deny" }
  ]
}
